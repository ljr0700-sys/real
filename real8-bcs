<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>부동산 자산 디지털 플랫폼 (Real8)</title>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js"></script>
    
    <style>
        /* 정린님의 기존 다크모드 디자인 유지 */
        body { background-color: #121212; color: white; font-family: 'Noto Sans KR', sans-serif; margin: 0; }
        #login-screen { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; }
        #main-content { display: none; } /* 로그인 전에는 숨김 */
        .login-btn { padding: 15px 30px; font-size: 18px; cursor: pointer; background: white; border-radius: 8px; font-weight: bold; }
        /* 정린님의 기존 테이블 및 카드 스타일... */
    </style>
</head>
<body>

    <div id="login-screen">
        <h1>Real8 플랫폼</h1>
        <p>회원가입 및 로그인을 위해 아래 버튼을 눌러주세요.</p>
        <button class="login-btn" onclick="googleLogin()">Google 계정으로 로그인</button>
    </div>

    <div id="main-content">
        <header style="background:#0056b3; padding:20px; text-align:center;">
            <h2>부동산 자산 디지털 플랫폼 (Real8)</h2>
            <p id="user-display" style="font-weight:bold;"></p>
        </header>

        <div style="padding:20px;">
            <h3>🛠 토큰/코인 발행 기준 및 관리</h3>
            <h3>📜 전체 코인 발행 대장 (해시값 기록)</h3>
            </div>
    </div>

    <script>
        // 정린님의 Firebase 프로젝트 설정
        const firebaseConfig = {
            apiKey: "AIzaSyDPDh41Coju7dojq3ATISTxJDIiypx8eA0", 
            authDomain: "real8-platform-8527b.firebaseapp.com",
            projectId: "real8-platform-8527b",
            appId: "1:268345819156:web:b017ad50d8d4e06f029001"
        };
        firebase.initializeApp(firebaseConfig);

        // 로그인/회원가입 함수
        function googleLogin() {
            const provider = new firebase.auth.GoogleAuthProvider();
            firebase.auth().signInWithPopup(provider).then((result) => {
                const user = result.user;
                // 성공 시 화면 전환
                document.getElementById('login-screen').style.display = 'none';
                document.getElementById('main-content').style.display = 'block';
                document.getElementById('user-display').innerText = user.displayName + "님, 접속 중";
                alert(user.displayName + "님, 환영합니다!");
            }).catch((e) => alert("에러: " + e.message));
        }

        // 정린님이 만드신 기존 해시값 생성/저장 자바스크립트는 이 아래에 붙여넣으세요.
    </script>
</body>
</html>
